                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/Upstream"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        },
        "description": "ファイル差分によるPRの作成、または既存PRの再利用。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PullRequestCreate"
              }
            }
          }
        }
      }
    },
    "/v2/prs/{number}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/Number"
        }
      ],
      "get": {
        "operationId": "getPullRequest",
        "tags": [
          "prs"
        ],
        "summary": "PR詳細を取得する",
        "security": [],
        "responses": {
          "200": {
            "description": "PRの詳細。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/Upstream"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        }
      }
    },
    "/v2/tree": {
      "get": {
        "operationId": "getTree",
        "tags": [
          "tree"
        ],
        "summary": "ツリー全件を取得する",
        "security": [],
        "responses": {
          "200": {
            "description": "ツリーの全件スナップショット。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TreeSnapshot"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "422": {
            "$ref": "#/components/responses/SnapshotLimit"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/Upstream"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        },
        "description": "同一コミットのファイル一覧と更新日時を含む全件スナップショット。"
      }
    },
    "/v2/files": {
      "get": {
        "operationId": "getFiles",
        "tags": [
          "files"
        ],
        "summary": "ファイル情報とダウンロードURLを取得する",
        "security": [],
        "responses": {
          "200": {
            "description": "ファイル情報とダウンロードURL。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Files"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/Upstream"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        },
        "description": "指定したファイルの情報と、コミットに固定されたダウンロードURL。",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "DCSWorld/またはUserMissions/配下の相対パス（UTF-8で4096バイト以内）。"
              },
              "minItems": 1,
              "maxItems": 100,
              "uniqueItems": true
            }
          }
        ]
      }
    },
    "/v2/tree-metadata": {
      "patch": {
        "operationId": "upsertTreeMetadata",
        "tags": [
          "tree-metadata"
        ],
        "summary": "ファイルの更新日時を一括登録・更新する",
        "security": [
          {
            "githubActionsOidc": []
          }
        ],
        "responses": {
          "200": {
            "description": "更新した件数。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetadataResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/PayloadTooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/Upstream"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        },
        "description": "GitHub ActionsのOIDC認証による、ファイル更新日時の一括登録・更新。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetadataUpdate"
              }
            }
          }
        }
      }
    },
    "/v2/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "OpenAPI仕様を取得する",
        "security": [],
        "responses": {
          "200": {
            "description": "公開するSSOTのOpenAPI仕様。",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "openapi",
                    "info",
                    "paths"
                  ],
                  "additionalProperties": true
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        }
      }
    },
    "/v2/docs": {
      "get": {
        "operationId": "getDocs",
        "summary": "APIドキュメントを表示する",
        "security": [],
        "responses": {
          "200": {
            "description": "Swagger UI。",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        }
      }
    },
    "/v2/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "health"
        ],
        "summary": "Workerの稼働状態を確認する",
        "security": [],
        "responses": {
          "200": {
            "description": "Workerの稼働状態。",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "406": {
            "$ref": "#/components/responses/NotAcceptable"
          },
          "500": {
            "$ref": "#/components/responses/Internal"
          },
          "502": {
            "$ref": "#/components/responses/Upstream"
          },
          "503": {
            "$ref": "#/components/responses/Unavailable"
          },
          "default": {
            "$ref": "#/components/responses/Other"
          }
        },
        "description": "APIの稼働状態を確認する。"
      }
    }
  },
  "components": {
    "securitySchemes": {
      "githubActionsOidc": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "GitHub ActionsのOIDC IDトークン（audience: tree-metadata）。"
      }
    },
    "parameters": {
      "Number": {
        "name": "number",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "description": "IssueまたはPRの番号。"
      },
      "State": {
        "name": "state",
        "in": "query",
        "schema": {
          "type": "string",
          "enum": [
            "open",
            "closed",
            "all"
          ],
          "default": "open"
        }
      },
      "Limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "description": "1ページの取得件数。"
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "description": "次ページの取得位置を表すカーソル（有効期間24時間）。"
      }
    },
    "responses": {
      "BadRequest": {
        "description": "リクエストの形式または入力値が不正。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "認証トークンが未指定または無効。",
        "headers": {
          "WWW-Authenticate": {
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Bearer認証の要求（realm=\"tree-metadata\"、error=\"invalid_token\"）。"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Forbidden": {
        "description": "必要な権限を満たさないトークン。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotFound": {
        "description": "対象のリソースが存在しない。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "NotAcceptable": {
        "description": "Acceptで指定されたメディアタイプに対応していない。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Conflict": {
        "description": "更新の競合、またはOIDCトークンの再利用。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "PayloadTooLarge": {
        "description": "リクエスト本文が上限の5 MiBを超過。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "リクエスト本文のContent-Typeに対応していない。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "リクエストが業務条件を満たさない。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "SnapshotLimit": {
        "description": "ツリーが100,000件または応答サイズ20 MiBの上限を超過。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "RateLimited": {
        "description": "送信元IPごとの書き込み上限（10回/300秒）に到達。",
        "headers": {
          "Retry-After": {
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "description": "再試行までの待機時間（秒）。"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Internal": {
        "description": "予期しない内部エラー。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Upstream": {
        "description": "GitHubとの通信または応答データのエラー。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Unavailable": {
        "description": "依存先の利用不可、またはGitHub側の回数制限。",
        "headers": {
          "Retry-After": {
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            },
            "description": "再試行を待つ秒数（整数）。"
          }
        },
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      },
      "Other": {
        "description": "共通形式のエラー応答。",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "properties": {
          "type": {
