                    "data": {
                      "nullable": true,
                    },
                    "message": {
                      "type": "string",
                    },
                    "success": {
                      "type": "boolean",
                    },
                  },
                  "required": [
                    "success",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "forbidden",
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "data": {
                      "nullable": true,
                    },
                    "message": {
