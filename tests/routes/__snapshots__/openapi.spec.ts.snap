                        },
                        "type": "array",
                      },
                      "type": "object",
                    },
                    "instance": {
                      "type": "string",
                    },
                    "status": {
                      "type": "integer",
                    },
                    "title": {
                      "type": "string",
                    },
                    "type": {
                      "type": "string",
                    },
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail",
                    "instance",
                  ],
                  "type": "object",
                },
              },
            },
            "description": "入力検証エラー",
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "properties": {
                    "detail": {
                      "type": "string",
                    },
                    "errors": {
                      "additionalProperties": {
