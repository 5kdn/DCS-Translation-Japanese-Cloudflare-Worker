#!/usr/bin/env sh
#
# summary:
#   - ブランチ名の命名規則チェック
#   - master/main 直接コミット禁止
#   - ローカル merge commit 禁止
#   - staged 差分のシークレット検出
#   - staged ファイルの Biome チェック
#
# notes:
#   - 保護ブランチへの直接コミットは、緊急時のみ ALLOW_DIRECT_COMMIT_TO_PROTECTED=1 で一時解除可能
#   - ローカル merge commit は、管理作業時のみ ALLOW_LOCAL_MERGE_COMMIT=1 で一時解除可能
#   - 許可するブランチ種別は BRANCH_TYPES で上書き可能
#   - Gitleaks がない環境では Docker を使用
#   - 例) git config core.hooksPath .githooks
#

set -eu

GITLEAKS_IMAGE='ghcr.io/gitleaks/gitleaks:v8.30.1'
DEFAULT_BRANCH_TYPES='feat|feature|fix|docs|style|refactor|perf|test|build|ci|chore|revert|dependabot'

# 必須コマンドが実行環境に存在することを検証する。
require_command() {
  command_name=$1

  if command -v "$command_name" >/dev/null 2>&1; then
    return 0
  fi

  printf '\033[1;31mERROR: 必須コマンドを利用できません: %s\033[0m\n' "$command_name" >&2
  exit 1
}

# 現在のブランチ名を取得し、detached HEAD では空文字を返す。
get_current_branch() {
  git symbolic-ref --quiet --short HEAD 2>/dev/null || printf ''
}

# commit 対象の追加・変更されたファイル一覧を取得する。
get_staged_files() {
  git diff --cached --name-only --diff-filter=ACMR
}

# protected branch への直接 commit を拒否する。
guard_protected_branch() {
  branch=$1

  case "$branch" in
    master|main)
      if [ "${ALLOW_DIRECT_COMMIT_TO_PROTECTED:-}" = '1' ]; then
        printf '\033[1;33mWARN: %sへの直接commitを一時的に許可します。\033[0m\n' "$branch" >&2
        return 0
      fi

      printf '\033[1;31mERROR: master/mainブランチへの直接commitは禁止されています。\033[0m\n' >&2
      printf '別ブランチで作業し、GitHub Pull Request経由で取り込んでください。\n' >&2
      printf '管理作業で必要な場合のみ、ALLOW_DIRECT_COMMIT_TO_PROTECTED=1を設定してください。\n' >&2
      exit 1
      ;;
  esac
}

# GitHub Pull Request 経由ではないローカル merge commit を拒否する。
guard_local_merge_commit() {
  if ! git rev-parse --verify --quiet MERGE_HEAD >/dev/null; then
    return 0
  fi

  if [ "${ALLOW_LOCAL_MERGE_COMMIT:-}" = '1' ]; then
    printf '\033[1;33mWARN: ローカルmerge commitを一時的に許可します。\033[0m\n' >&2
    return 0
  fi

  printf '\033[1;31mERROR: ローカルmerge commitは禁止されています。\033[0m\n' >&2
  printf 'GitHub Pull Request経由でmergeしてください。\n' >&2
  printf '管理作業で必要な場合のみ、ALLOW_LOCAL_MERGE_COMMIT=1を設定してください。\n' >&2
  exit 1
}

# 指定された type がパイプ区切りの許可一覧に含まれるかを判定する。
is_allowed_branch_type() {
  requested_type=$1
  remaining_types=$2

  while [ -n "$remaining_types" ]; do
    case "$remaining_types" in
      *'|'*)
        allowed_type=${remaining_types%%|*}
        remaining_types=${remaining_types#*|}
        ;;
      *)
        allowed_type=$remaining_types
        remaining_types=''
        ;;
    esac

    if [ -n "$allowed_type" ] && [ "$requested_type" = "$allowed_type" ]; then
      return 0
    fi
  done

  return 1
}

# ブランチ名が <type>/<description> 形式であることを検証する。
validate_branch_name() {
  branch=$1
  branch_types=${BRANCH_TYPES:-$DEFAULT_BRANCH_TYPES}

  case "$branch" in
    master|main)
      return 0
      ;;
  esac

  branch_type=${branch%%/*}
  branch_description=${branch#*/}

  if [ "$branch_type" != "$branch" ] &&
    [ -n "$branch_type" ] &&
    [ -n "$branch_description" ] &&
    is_allowed_branch_type "$branch_type" "$branch_types"; then
    return 0
  fi

  printf '\033[1;31mERROR: ブランチ名が命名規則に一致しません: %s\033[0m\n\n' "$branch" >&2
  printf '許可される形式:\n' >&2
  printf '  <type>/<description>\n\n' >&2
  printf '例:\n' >&2
  printf '  feat/123-add-login\n' >&2
  printf '  fix/ABC-456/fix-npe\n' >&2
  printf '  docs/update-readme\n\n' >&2
  printf '許可されるtype: %s\n' "$branch_types" >&2
  printf 'カスタムtypeを使用する場合はBRANCH_TYPESをパイプ区切りで設定してください。\n' >&2
  printf 'ブランチ名は git branch -m <new-branch-name> で変更できます。\n' >&2
  exit 1
}

# Gitleaks をローカル実行し、未導入の場合は公式 Docker image で実行する。
run_gitleaks_stdin() {
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks --no-banner --redact stdin
    return
  fi

  if command -v docker >/dev/null 2>&1; then
    docker run --rm -i "$GITLEAKS_IMAGE" --no-banner --redact stdin
    return
  fi

  printf '\033[1;31mERROR: GitleaksまたはDockerを利用できません。\033[0m\n' >&2
  printf 'Gitleaksをインストールするか、Dockerを起動してから再実行してください。\n' >&2
  return 127
}

# commit 対象の staged 差分にシークレットが含まれていないことを検証する。
run_secret_detection() {
  printf '\033[36m==> staged secret detection\033[0m\n'

  if git diff --cached --no-ext-diff --diff-filter=ACMR | run_gitleaks_stdin; then
    printf '\033[32m==> success staged secret detection\033[0m\n'
    return 0
  else
    status=$?
  fi

  if [ "$status" -eq 1 ]; then
    printf '\033[1;31mERROR: staged差分にシークレットの疑いがある値が含まれています。\033[0m\n' >&2
    printf '検出内容を確認し、Secret管理機構や環境変数参照へ移してください。\n' >&2
  elif [ "$status" -ne 127 ]; then
    printf '\033[1;31mERROR: Gitleaksによる検査を完了できませんでした (exit %s)。\033[0m\n' "$status" >&2
    printf 'GitleaksまたはDockerの実行環境を確認してください。\n' >&2
  fi
  exit "$status"
}

# Biome で commit 対象の staged ファイルを検証する。
run_biome_gate() {
  require_command corepack
  printf '\033[36m==> Biome staged check\033[0m\n'

  if corepack pnpm exec biome check --staged --no-errors-on-unmatched; then
    printf '\033[32m==> success Biome staged check\033[0m\n'
    return 0
  fi

  printf '\033[1;31mERROR: Biomeによるstagedファイルの検査に失敗しました。\033[0m\n' >&2
  printf 'corepack pnpm check を実行して内容を確認してください。\n' >&2
  printf '自動修正する場合は corepack pnpm check --write を実行し、修正をstageし直してください。\n' >&2
  exit 1
}

# pre-commit hook の実行順序を制御する。
main() {
  require_command git

  branch=$(get_current_branch)
  guard_local_merge_commit

  if [ -n "$branch" ]; then
    guard_protected_branch "$branch"
    validate_branch_name "$branch"
  fi

  staged_files=$(get_staged_files)
  if [ -z "$staged_files" ]; then
    exit 0
  fi

  run_secret_detection
  run_biome_gate
}

main "$@"
