{
  "name": "dcs-translation-japanese-cloudflare-worker",
  "version": "1.5.3",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --script src/index.dev.ts",
    "lint": "biome lint .",
    "fmt": "biome format . --write",
    "check": "biome check .",
    "start": "wrangler dev",
    "test": "vitest --run",
    "test:unit": "vitest --project unit --run",
    "test:integration": "vitest --project integration --run",
    "test:e2e": "vitest --project e2e --run",
    "cf-typegen": "wrangler types",
    "generate-licenses": "node -e \"const fs=require('node:fs'); fs.rmSync('THIRD-PARTY-NOTICES/files',{ recursive:true, force:true }); fs.mkdirSync('THIRD-PARTY-NOTICES/files',{ recursive:true });\" && license-checker-rseidelsohn --markdown --production --excludePrivatePackages --out THIRD-PARTY-NOTICES/THIRD-PARTY-NOTICES.md --files THIRD-PARTY-NOTICES/files"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@octokit/types": "^16.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.12.21",
    "jose": "^6.2.3",
    "octokit": "^5.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vitest-pool-workers": "^0.16.12",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.93.0"
  }
}
