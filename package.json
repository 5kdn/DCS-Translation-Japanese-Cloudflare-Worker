{
  "name": "dcs-translation-japanese-cloudflare-worker",
  "version": "1.5.2",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --script src/index.dev.ts",
    "lint": "biome lint .",
    "fmt": "biome format . --write",
    "check": "biome check .",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "generate-licenses": "node -e \"const fs=require('node:fs'); fs.rmSync('THIRD-PARTY-NOTICES/files',{ recursive:true, force:true }); fs.mkdirSync('THIRD-PARTY-NOTICES/files',{ recursive:true });\" && license-checker-rseidelsohn --markdown --production --excludePrivatePackages --out THIRD-PARTY-NOTICES/THIRD-PARTY-NOTICES.md --files THIRD-PARTY-NOTICES/files"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@cloudflare/vitest-pool-workers": "^0.16.7",
    "@types/node": "^25.8.0",
    "esbuild": "^0.28.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^6.0.3",
    "vitest": "~3.2.4",
    "wrangler": "^4.66.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.3",
    "@hono/zod-openapi": "^1.2.2",
    "@octokit/types": "^16.0.0",
    "fflate": "^0.8.2",
    "hono": "^4.11.9",
    "jose": "^6.1.3",
    "octokit": "^5.0.5",
    "zod": "^4.3.6"
  }
}
