{
  "name": "dcs-translation-japanese-cloudflare-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --script src/index.dev.ts",
    "lint": "biome lint .",
    "fmt": "biome format . --write",
    "check": "biome check .",
    "start": "wrangler dev",
    "test": "vitest",
    "cf-typegen": "wrangler types",
    "generate-licenses": "license-checker-rseidelsohn --markdown --production --excludePrivatePackages --out THIRD-PARTY-NOTICES/THIRD-PARTY-NOTICES.md --files THIRD-PARTY-NOTICES/files"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.4",
    "@cloudflare/vitest-pool-workers": "^0.10.8",
    "@types/node": "^24.10.0",
    "esbuild": "^0.27.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "typescript": "^5.9.3",
    "vitest": "~3.2.x",
    "wrangler": "^4.51.0"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.4",
    "@octokit/types": "^16.0.0",
    "fflate": "^0.8.2",
    "hono": "^4.10.4",
    "octokit": "^5.0.5",
    "zod": "^4.1.12"
  }
}
