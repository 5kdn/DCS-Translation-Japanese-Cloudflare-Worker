{
  "name": "dcs-translation-japanese-cloudflare-worker",
  "version": "1.5.5",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "deploy": "pnpm generate && cf deploy",
    "dev": "pnpm generate && cf dev --mode development",
    "lint": "biome lint .",
    "fmt": "biome format . --write",
    "check": "biome check .",
    "typecheck": "pnpm generate && tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "start": "pnpm generate && cf dev --mode production",
    "test": "pnpm generate && vitest --run",
    "test:unit": "pnpm generate && vitest --project unit --run",
    "test:integration": "pnpm generate && vitest --project integration --run",
    "test:e2e": "pnpm generate && vitest --project e2e --run",
    "generate": "pnpm cf-typegen",
    "cf-typegen": "cf workers types",
    "generate-licenses": "node -e \"const fs=require('node:fs'); fs.rmSync('THIRD-PARTY-NOTICES/files',{ recursive:true, force:true }); fs.mkdirSync('THIRD-PARTY-NOTICES/files',{ recursive:true });\" && license-checker-rseidelsohn --markdown --production --excludePrivatePackages --out THIRD-PARTY-NOTICES/THIRD-PARTY-NOTICES.md --files THIRD-PARTY-NOTICES/files"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@octokit/types": "^18.0.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "octokit": "^5.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@cloudflare/vitest-plugin": "1.4.11",
    "@types/node": "^26.6.6",
    "cf": "1.0.0-beta.26",
    "esbuild": "^0.28.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
